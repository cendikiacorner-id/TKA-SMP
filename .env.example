# Salin menjadi .env lalu sesuaikan (JANGAN commit berkas .env).
# Aplikasi membaca variabel ini saat dijalankan.

# Port server (banyak platform seperti Render/Railway mengisinya otomatis)
PORT=8000

# Mode demo: 1 = sertakan akun & data contoh (untuk mencoba), 0 = bersih (produksi)
TKA_SEED_DEMO=1

# Akun guru/admin pertama yang dibuat otomatis
TKA_ADMIN_EMAIL=guru@tka.id
TKA_ADMIN_NAME=Guru TKA
TKA_ADMIN_PASSWORD=guru123

# Kode akses pendaftaran guru baru
GURU_CODE=GURU2026

# Nilai minimum ketuntasan bawaan
TKA_KKM=70

# Lokasi folder basis data (kosongkan untuk memakai folder aplikasi)
TKA_DB_DIR=
